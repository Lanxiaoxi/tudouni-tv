<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 软件更新：调起系统安装器安装下载的 APK（Android 8+ 需用户授予"安装未知应用"） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- TV 设备特性：leanback 非必需（国内盒子侧载场景） -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/tudouni"
        android:roundIcon="@mipmap/tudouni_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TudouniTV"
        android:usesCleartextTraffic="true">
        <!--
          M4 说明：allowBackup=false 防止 DataStore（含 token）被 ADB/云备份拷走。
          usesCleartextTraffic=true 为播放直连所必需——资源站 m3u8/封面大量使用 http 明文，
          全局禁用会黑屏；如未来要收敛，改用 res/xml/network_security_config.xml 按域名白名单。
        -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 软件更新：向系统安装器共享下载的 APK（Android 7+ 禁止 file:// URI） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
